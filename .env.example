# BorderGlow Backend Environment Configuration

NODE_ENV=production
PORT=3000

# Hosted PostgreSQL Database
DATABASE_URL=postgresql://username:password@hostname:5432/borderglow_staging?sslmode=require
USE_POSTGRES=true

# Persistent Attachment Storage Directory (Render disk mount path)
ATTACHMENT_STORAGE_DIR=/var/data/attachments

# Security Secrets (Minimum 32 characters)
SESSION_SECRET=YOUR_MINIMUM_32_CHAR_HMAC_SESSION_SECRET
COMPLIANCE_SIGNING_SECRET=YOUR_MINIMUM_32_CHAR_COMPLIANCE_SECRET

# CORS & Frontend Origins (Comma-separated)
FRONTEND_URL=https://app.borderglow.trade
ALLOWED_ORIGINS=https://app.borderglow.trade,https://borderglow-frontend.vercel.app

# Cookie Settings ("lax" when on shared apex domain or proxied; "none" for pure cross-origin)
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.borderglow.trade

# WebRTC Ephemeral TURN Relay
TURN_SERVER_URL=turns:turn.borderglow.trade:5349?transport=tcp
TURN_SECRET=YOUR_COTURN_SHARED_HMAC_SECRET

# Email (Resend)
RESEND_API_KEY=re_YOUR_ACTUAL_RESEND_API_KEY
EMAIL_FROM=BorderGlow Support <support@trade.borderglow.com>

# Safeguards
ALLOW_PRODUCTION_SEED=false
