# ==============================================================================
# BorderGlow Express.js + MongoDB Backend Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=10000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/borderglow?retryWrites=true&w=majority

# Authentication & Session Security (Min 32 characters random hex)
SESSION_SECRET=bg_prod_session_secret_f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4
JWT_SECRET=bg_prod_session_secret_f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4
COOKIE_SAME_SITE=none

# Frontend Origin and CORS (Vercel deployment URL)
FRONTEND_URL=https://border-to-border-export-frontend.vercel.app
ALLOWED_ORIGINS=https://border-to-border-export-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# Email Delivery (Gmail SMTP App Password or Resend API Key)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yasinsasoli186@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=BorderGlow Verification <yasinsasoli186@gmail.com>
RESEND_API_KEY=re_your_resend_api_key

# Attachments Storage Directory
ATTACHMENT_STORAGE_DIR=./data/attachments

# WebRTC STUN/TURN (Optional for symmetric NATs)
TURN_SERVER_URL=
TURN_SECRET=

# Seed Control
ALLOW_PRODUCTION_SEED=false
