{
  "name": "borderglow-backend",
  "version": "2.0.0",
  "description": "BorderGlow Trade & Transport Express.js API Engine with MongoDB",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "echo 'Backend build ready'",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node -e \"import('./src/config/db.js').then(m => m.connectDB()).then(() => import('./src/services/seedService.js')).then(m => m.seedDatabase()).then(() => process.exit(0))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
